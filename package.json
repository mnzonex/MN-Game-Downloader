{
  "name": "mn-game-downloader",
  "description": "MN Game Downloader - Fast PC Game Downloader & Library Manager",
  "author": "mnzonex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node scripts/download-aria2.js",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "npm run build && node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000/api/version && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "app:build": "npm run electron:build",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mnzonex.gamedownloader",
    "productName": "MN Game Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json",
      "icon.ico",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "dist/server.cjs",
        "to": "dist/server.cjs"
      },
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "aria2c.exe"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mnzonex",
      "repo": "MN-Game-Downloader"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MN Game Downloader"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/webtorrent": "^0.110.1",
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin": "^5.2.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cloudscraper": "^4.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.7",
    "vite": "^6.2.3",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnzonex/MN-Game-Downloader.git"
  }
}